# ===========================================================================
# ResearchOS frontend configuration
# Copy to `frontend/.env` (local) or set these in your host's dashboard
# (Vercel → Project → Settings → Environment Variables).
# NEVER put backend secrets here: everything VITE_* is embedded in the bundle.
# ===========================================================================

# --- Backend origin (production) -------------------------------------------
# Leave EMPTY for local development: the Vite dev server proxies /api/* to
# http://127.0.0.1:8000 automatically (see vite.config.js), so no localhost URL
# is ever baked into the bundle.
#
# Set it in production to your deployed API, e.g.:
#   VITE_API_BASE_URL=https://researchos-api.onrender.com
VITE_API_BASE_URL=

# --- Dev-server proxy target (optional) ------------------------------------
# Where `npm run dev` forwards /api/* requests. Defaults to 127.0.0.1:8000.
# Change it when the backend runs on a different host/port.
VITE_BACKEND_URL=http://127.0.0.1:8000
