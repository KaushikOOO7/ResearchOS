# ========================================================
# ResearchOS Backend Configuration
# ========================================================

# Google Gemini API key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=

# Primary Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Optional Fallback Model (used if primary encounters transient 503/429)
GEMINI_FALLBACK_MODEL=

# CORS Allowed Origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Backend Port
PORT=8000
