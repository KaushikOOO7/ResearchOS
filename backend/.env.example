# ===========================================================================
# ResearchOS backend configuration
# Copy this file to `backend/.env` and fill in your own values.
# NEVER commit the real .env file (it is gitignored).
#
# In production (Render etc.) set these as environment variables in the
# dashboard instead of using a file — see render.yaml and the README.
# ===========================================================================

# --- AI provider (required for AI analysis; search works without it) -------
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Primary model and optional fallback (used only when the primary keeps
# failing with a transient error after the built-in retries).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.2

# --- Research providers ----------------------------------------------------
# All providers work WITHOUT a key. Supplying a contact email opts you into the
# polite/faster pools of OpenAlex and Crossref (recommended).
OPENALEX_EMAIL=you@example.com
CROSSREF_EMAIL=you@example.com
CONTACT_EMAIL=you@example.com

# Optional: Semantic Scholar is only queried when a key is present
# (the keyless public pool returns HTTP 429 frequently).
SEMANTIC_SCHOLAR_API_KEY=

# Optional: PubMed / NCBI E-utilities (raises the rate limit from 3 to 10 req/s)
PUBMED_ENABLED=true
NCBI_API_KEY=
PUBMED_EMAIL=you@example.com

# --- Search behaviour ------------------------------------------------------
# Candidate pool target before ranking, and how many papers to return.
RESEARCH_TARGET_CANDIDATES=90
RESEARCH_MAX_RESULTS=30
RESEARCH_MIN_RESULTS=30
PROVIDER_TIMEOUT_SECONDS=25
SEARCH_DEADLINE_SECONDS=45

# --- Ranking weights (must be >= 0; they are renormalised per paper) -------
RANK_WEIGHT_RELEVANCE=0.50
RANK_WEIGHT_QUALITY=0.20
RANK_WEIGHT_CITATION=0.15
RANK_WEIGHT_RECENCY=0.10
RANK_WEIGHT_SOURCE=0.05

# --- PDF / analysis limits -------------------------------------------------
PDF_MAX_BYTES=26214400        # 25 MB
PDF_MAX_PAGES=80
PDF_DOWNLOAD_TIMEOUT=45
ANALYSIS_MAX_CHARS=120000

# Optional STRICT allowlist of hosts permitted for PDF downloads (comma
# separated). Empty = any public host, because open-access PDFs are served from
# thousands of publisher domains; private/metadata addresses are always blocked.
# Example: PDF_ALLOWED_HOSTS=arxiv.org,doi.org,mdpi.com
PDF_ALLOWED_HOSTS=

# --- API / CORS ------------------------------------------------------------
# Comma-separated explicit origins. Add your deployed frontend URL here, e.g.
#   CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://researchos.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Regex for extra trusted origins (e.g. Vercel preview deployments).
# Set it EMPTY to disable. Never use allow_origins=["*"] with credentials.
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*(vercel\.app|e2b\.app|arena\.ai)$

# --- Server ----------------------------------------------------------------
# Local development port. In production Render injects $PORT automatically and
# uvicorn must bind to it:  uvicorn app.main:app --host 0.0.0.0 --port $PORT
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
